{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tailshare",
  "version": "0.1.2",
  "identifier": "dev.tailshare.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run server && npm run rclone && npm run dev",
    "beforeBuildCommand": "npm run server && npm run rclone && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "tailshare",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/tailshare-server",
      "binaries/rclone"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCM0UxNTQxNDc0M0UzNjMKUldSajQwTkhRUlUrMjdjU3hFNmxGQldMeGhRYTdOVEtQWDhweDRPT0ZpWDg5aGhIc3oxRDNMdXAK",
      "endpoints": [
        "https://github.com/Sirsyorrz/tailshare/releases/latest/download/latest.json"
      ]
    }
  }
}
